# {{ ansible_managed }}
# Généré par Ansible (rôle application) : ne pas modifier à la main sur le serveur.

DJANGO_SECRET_KEY={{ app_django_secret_key }}
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS={{ app_domaine }},localhost,127.0.0.1,backend

{% if app_https | bool %}
# Pile légère : base externe (Neon) et HTTPS assuré par Caddy
APP_DOMAINE={{ app_domaine }}
DATABASE_URL={{ app_database_url }}
DJANGO_DERRIERE_PROXY_HTTPS=True
CSRF_TRUSTED_ORIGINS={{ app_schema }}://{{ app_domaine }}
{% if app_supervision_cloud | bool %}

# Supervision : Alloy envoie métriques et journaux vers Grafana Cloud
COMPOSE_PROFILES=supervision
GRAFANA_CLOUD_PROM_URL={{ app_grafana_cloud_prom_url }}
GRAFANA_CLOUD_PROM_USER={{ app_grafana_cloud_prom_user }}
GRAFANA_CLOUD_LOKI_URL={{ app_grafana_cloud_loki_url | regex_replace('/+$', '') }}
GRAFANA_CLOUD_LOKI_USER={{ app_grafana_cloud_loki_user }}
GRAFANA_CLOUD_TOKEN={{ app_grafana_cloud_token }}
{% endif %}
{% else %}
POSTGRES_DB=gestion_patients
POSTGRES_USER=gestion_user
POSTGRES_PASSWORD={{ app_postgres_password }}
POSTGRES_PORT=5432

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD={{ app_grafana_password }}
{% endif %}

CORS_ALLOWED_ORIGINS={{ app_schema }}://{{ app_domaine }}
FRONTEND_URL={{ app_schema }}://{{ app_domaine }}

{% if app_email_utilisateur and app_email_mot_de_passe %}
# E-mails (codes de réinitialisation) envoyés par SMTP (ex. Gmail + mot de passe d'application)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER={{ app_email_utilisateur }}
EMAIL_HOST_PASSWORD={{ app_email_mot_de_passe }}
DEFAULT_FROM_EMAIL={{ app_email_utilisateur }}
EMAIL_TIMEOUT=10
{% else %}
# Démonstration : les e-mails (codes OTP) s'affichent dans les journaux
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@gestion-patients.local
{% endif %}
