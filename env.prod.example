# Modèle du fichier .env de PRODUCTION (à copier en .env sur le serveur).
# Les valeurs CHANGE_ME_* et SERVER_IP sont remplacées sur le serveur.
# Ne jamais commiter le vrai fichier .env.

# Django
DJANGO_SECRET_KEY=CHANGE_ME_SECRET
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=SERVER_IP,localhost,127.0.0.1

# PostgreSQL (POSTGRES_HOST est fixé à "db" par docker-compose.prod.yml)
POSTGRES_DB=gestion_patients
POSTGRES_USER=gestion_user
POSTGRES_PASSWORD=CHANGE_ME_DB
POSTGRES_PORT=5432

# Adresses
CORS_ALLOWED_ORIGINS=http://SERVER_IP
FRONTEND_URL=http://SERVER_IP

# E-mail : en démonstration, les messages (codes OTP) s'affichent dans les logs
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@gestion-patients.local
EMAIL_TIMEOUT=5
